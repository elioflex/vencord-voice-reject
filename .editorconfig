# Matches the style Vencord itself enforces (see its eslint.config.mjs):
# 4-space indent, double quotes, semicolons, LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 120

[*.md]
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2

[*.sh]
# Shell scripts are indented with 4 spaces here, matching dev.sh.
indent_size = 4
