        "url": "git+https://github.com/elioflex/vencord-voice-reject.git"
    },
    "homepage": "https://github.com/elioflex/vencord-voice-reject#readme",
    "bugs": {
        "url": "https://github.com/elioflex/vencord-voice-reject/issues"
    },
    "scripts": {
        "sync": "./dev.sh sync",
        "build": "./dev.sh build",
        "reload": "./dev.sh reload",
        "restart": "./dev.sh restart",
        "logs": "./dev.sh logs",
        "cycle": "./dev.sh cycle"
    },
    "engines": {
        "node": ">=18"
    }
}
